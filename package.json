{
  "name": "@zamiell/typedoc-plugin-not-exported",
  "version": "0.4.0",
  "description": "TypeDoc plugin that forces inclusion of non-exported symbols (variables)",
  "main": "dist/main.js",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "scripts": {
    "build": "rimraf dist && tsc",
    "test": "npm run build && npm run test:gen && npm run test:jest && npm run test:cleanup",
    "test:cleanup": "rimraf --glob \"test/fixtures/*/output.json\"",
    "test:gen": "npm run test:cleanup && node tools/generate-test-docs.js",
    "test:jest": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --no-cache --runInBand",
    "lint": "eslint .",
    "format": "prettier --check .",
    "addscope": "node tools/packagejson name @zamiell/typedoc-plugin-not-exported"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "typedocplugin",
    "typedoc-plugin",
    "typedoc",
    "plugin",
    "doc",
    "docs",
    "typescript",
    "export",
    "include"
  ],
  "author": "Zamiell",
  "license": "CC0-1.0",
  "homepage": "https://github.com/Zamiell/typedoc-plugin-not-exported",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/Zamiell/typedoc-plugin-not-exported.git"
  },
  "bugs": {
    "url": "https://github.com/Zamiell/typedoc-plugin-not-exported/issues"
  },
  "peerDependencies": {
    "typedoc": "^0.28.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.12.0",
    "jest": "^30.5.1",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.4.12",
    "typedoc": "0.28.20",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0"
  }
}
